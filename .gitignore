# Dependencies
node_modules/
yarn.lock
pnpm-lock.yaml

# Build outputs
.next/
dist/
build/
out/

# Environment variables - NEVER commit
.env
.env.local
.env.*.local
.env.production
.env.production.local

# Credentials & Secrets - NEVER commit
# All credentials are stored in AWS Secrets Manager
.aws-credentials
*.pem
*.key
*.secret
credentials.json
~/.aws/

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Testing
coverage/
.nyc_output/

# Misc
*.temp
.cache/
tsconfig.tsbuildinfo
.vercel
.env*.local

# Local screenshot artifacts (never commit)
visual-review-screenshots/
visual-review-screenshots.zip

# Agent work scratch and cache (never commit)
agent-work/tmp/
agent-work/.cache/

# Content intake staging - source material dropped here for listings/blog
# posts (photos, feature sheets, competitor reference screenshots) gets
# copied into public/ or src/content/ deliberately; the drop folder itself
# is never meant to be committed.
/~drop here/

# Ad hoc local capture/debug scripts and screenshots left at the repo root
# (leading slash scopes these to the root only, not public/ or src/ assets)
/capture-*.js
/*.png
